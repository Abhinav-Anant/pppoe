[Unit]
Description=BNG management API, TLS listener for a central console (management plane only)
After=network-online.target postgresql.service
Wants=postgresql.service
# off until the operator chooses an address: see docs/multi-bng.md
ConditionPathExists=/etc/bng-platform/api-remote.env

[Service]
# BNG_API_REMOTE_HOST (management address) and BNG_API_REMOTE_PORT (e.g. 8443)
EnvironmentFile=/etc/bng-platform/api-remote.env
ExecStart=/opt/bng-platform/venv/bin/uvicorn --factory app.api.main:create_app \
  --host ${BNG_API_REMOTE_HOST} --port ${BNG_API_REMOTE_PORT} --workers 1 --no-server-header --log-level warning \
  --ssl-certfile /etc/bng-platform/tls/api.crt --ssl-keyfile /etc/bng-platform/tls/api.key
Restart=on-failure
RestartSec=3
# same privileges and sandbox as bng-api.service
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/bng-platform /var/lib/bng-platform
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
