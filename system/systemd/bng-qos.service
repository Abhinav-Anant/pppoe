[Unit]
Description=bng-platform aggregate CAKE on the uplink (generated /etc/bng-platform/tc/cake.sh)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/bng-platform/tc/cake.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /etc/bng-platform/tc/cake.sh

[Install]
WantedBy=multi-user.target
